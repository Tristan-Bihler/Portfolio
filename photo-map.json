---
layout: null
permalink: /photo-map.json
---
[
{% assign photos = site.data.photo_map | where_exp: "p", "p.lat != 'FILLME'" %}
{% for p in photos %}
  {
    "lat": {{ p.lat }},
    "lng": {{ p.lng }},
    "thumb": {{ p.thumb | relative_url | jsonify }},
    "full": {{ p.full | jsonify }},
    "trip": {{ p.trip | jsonify }},
    "caption": {{ p.caption | jsonify }},
    "approx": {% if p.source == 'manual' %}true{% else %}false{% endif %}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
